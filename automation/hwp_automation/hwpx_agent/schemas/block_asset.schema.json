{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hwpx-agent/schemas/block_asset.schema.json",
  "title": "HWPX Block Asset",
  "type": "object",
  "required": [
    "schema_version",
    "asset_id",
    "asset_type",
    "source_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "paragraph",
        "table",
        "table_cell",
        "image_occurrence",
        "masterpage"
      ]
    },
    "section_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "page_no": {
      "type": [
        "integer",
        "null"
      ]
    },
    "page_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "root_flow_paragraph_index": {
      "type": [
        "integer",
        "null"
      ]
    },
    "source_ref": {
      "type": "object",
      "required": [
        "package_entry",
        "xml_path"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "embedded_object_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classification": {
      "type": "object",
      "properties": {
        "context_type": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "is_root_flow": {
          "type": "boolean"
        },
        "root_flow_paragraph_index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "host_body_paragraph_asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "host_root_flow_paragraph_index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "rebuild_safe_text_only": {
          "type": "boolean"
        }
      }
    }
  }
}
