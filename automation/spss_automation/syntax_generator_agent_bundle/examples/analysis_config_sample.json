{
  "_comment": "generate_syntax.py 실행용 설정 파일 샘플. 실제 사용 시 project_name, banner, label_sps, sections 를 프로젝트에 맞게 수정하세요.",

  "project_name": "샘플 설문조사",
  "version": "1.0.0",
  "encoding": "cp949",
  "output_name": "sample_analysis",

  "banner": {
    "variables": ["SQ1", "SQ2", "SQ3"],
    "validn_label": "응답수"
  },

  "label_sps": "sample_label_short.sps",

  "sections": [

    {
      "title": "응답자 특성",
      "_comment": "type=freq: 단수응답 빈도+비율. var=변수명, label=통계표 제목(없으면 label_sps에서 자동), comment=SPS 주석",
      "items": [
        {
          "type": "freq",
          "var": "SQ1",
          "label": "성별",
          "comment": "*성별."
        },
        {
          "type": "freq",
          "var": "SQ2",
          "label": "연령대",
          "comment": "*연령대."
        },
        {
          "type": "freq",
          "var": "SQ3",
          "label": "거주지역",
          "comment": "*거주지역."
        }
      ]
    },

    {
      "title": "인지 및 이용 현황",
      "items": [
        {
          "_comment": "type=freq: 단순 빈도, label 생략 시 label_sps에서 자동 참조",
          "type": "freq",
          "var": "A1",
          "comment": "*서비스 인지 여부."
        },
        {
          "_comment": "type=freq_each: 동일 접두사 변수 N개를 각각 freqt로 반복 생성. prefix_from_to 필수",
          "type": "freq_each",
          "prefix": "A2",
          "from": 1,
          "to": 5,
          "auto_label": true,
          "_comment2": "auto_label=true이면 label_sps에서 변수별 라벨 자동 참조"
        }
      ]
    },

    {
      "title": "만족도 분석",
      "items": [
        {
          "_comment": "type=mean: 여러 변수의 평균을 cm1t로 출력. vars 또는 prefix+from+to 방식 모두 가능",
          "type": "mean",
          "vars": ["B1_1", "B1_2", "B1_3", "B1_4", "B1_5"],
          "label": "부문별 만족도",
          "comment": "*부문별 만족도."
        },
        {
          "_comment": "type=mean prefix 방식: B2_1 ~ B2_8을 자동 생성",
          "type": "mean",
          "prefix": "B2",
          "from": 1,
          "to": 8,
          "label": "세부 항목 만족도",
          "comment": "*세부 항목 만족도."
        },
        {
          "_comment": "type=scale: 척도형 문항(빈도+평균). var=범주변수, scale_var=원점수변수",
          "type": "scale",
          "var": "B3",
          "scale_var": "B3S",
          "label": "종합 만족도",
          "comment": "*종합 만족도(척도)."
        }
      ]
    },

    {
      "title": "복수응답 분석",
      "items": [
        {
          "_comment": "type=multi: 복수응답. from/to=범위변수, group=MRGROUP명(없으면 자동 mg1, mg2...), mr_label=그룹 라벨, title=통계표 제목",
          "type": "multi",
          "from": "C1_1",
          "to": "C1_7",
          "group": "mg_c1",
          "mr_label": "이용 채널",
          "title": "이용 채널(복수응답)",
          "comment": "*이용 채널(복수응답)."
        },
        {
          "type": "multi",
          "from": "C2_1",
          "to": "C2_5",
          "group": "mg_c2",
          "mr_label": "불편 요인",
          "title": "불편 요인(복수응답)",
          "comment": "*불편 요인(복수응답)."
        }
      ]
    },

    {
      "title": "변수 리코딩",
      "_comment": "type=recode 항목은 실제 분석 구문보다 앞에 배치됩니다(generate_syntax.py가 자동으로 앞으로 이동). sections 어디에 넣어도 무방합니다.",
      "items": [
        {
          "_comment": "type=recode: SPSS RECODE 구문 생성. source=원본변수(2개면 TO 구문), target=생성변수, mapping=값 대응표",
          "type": "recode",
          "source": ["SQ2"],
          "target": ["SQ2R"],
          "mapping": {
            "1": "1",
            "2": "1",
            "3": "2",
            "4": "2",
            "5": "3"
          },
          "target_labels": {
            "SQ2R": "연령대(통합)"
          }
        }
      ]
    },

    {
      "title": "필터 적용 예시",
      "_comment": "filter 키를 추가하면 TEMPORARY + SELECT IF 구문이 자동 삽입됩니다.",
      "items": [
        {
          "type": "freq",
          "var": "D1",
          "label": "서비스 개선 의향(남성)",
          "comment": "*서비스 개선 의향 - 남성 한정.",
          "filter": {
            "var": "SQ1",
            "op": "=",
            "val": 1
          }
        }
      ]
    }

  ]
}
